modules = ["nodejs-20", "python-3.11"]
[nix]
channel = "stable-25_05"
packages = ["abseil-cpp", "glibcLocales", "gtest"]

[agent]
expertMode = true

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 22801
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "npx serve dist --single --listen $PORT"]
build = ["bash", "-c", "npm install -g pnpm@10 && pnpm install && pnpm exec expo export --platform web"]
