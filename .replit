modules = ["nodejs-20"]
[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[[ports]]
localPort = 22801
externalPort = 80

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "npx serve dist --single --listen $PORT"]
build = ["bash", "-c", "npm install -g pnpm@latest && pnpm install && pnpm exec expo export --platform web"]
publicDir = "dist"
