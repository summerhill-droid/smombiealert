{
  "expo": {
    "name": "SmombieAlert",
    "slug": "smombie-detector",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "smombie-detector",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E84545"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.smombiealert.app",
      "infoPlist": {
        "NSMotionUsageDescription": "SmombieAlert uses motion sensors to detect if you are walking while distracted by your phone.",
        "NSLocationWhenInUseUsageDescription": "Location is used to detect crosswalks and accident zones near you.",
        "UIBackgroundModes": ["location"]
      }
    },
    "android": {
      "package": "com.smombiealert.app",
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.VIBRATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.HIGH_SAMPLING_RATE_SENSORS",
        "android.permission.WAKE_LOCK"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-dev-client",
      [
        "expo-brightness",
        {
          "brightnessPermission": "Allow SmombieAlert to dim your screen as a safety warning when distracted phone use is detected."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
