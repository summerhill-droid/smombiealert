{
  "expo": {
    "name": "SmombieAlert",
    "slug": "smombie-detector",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "smombie-detector",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E84545"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.smombiealert.app",
      "infoPlist": {
        "NSMotionUsageDescription": "SmombieAlert uses motion sensors to detect if you are walking while distracted by your phone.",
        "NSLocationWhenInUseUsageDescription": "Location is used to detect crosswalks and accident zones near you.",
        "UIBackgroundModes": [
          "location",
          "location",
          "location"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSExceptionDomains": {
            "kakao.com": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": true
            },
            "t-data.seoul.go.kr": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            },
            "apis.data.go.kr": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.smombiealert.app",
      "usesCleartextTraffic": true,
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.VIBRATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.HIGH_SAMPLING_RATE_SENSORS",
        "android.permission.WAKE_LOCK",
        "android.permission.WRITE_SETTINGS",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.VIBRATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.HIGH_SAMPLING_RATE_SENSORS",
        "android.permission.WAKE_LOCK",
        "android.permission.WRITE_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-dev-client",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Used to check nearby crosswalks and pedestrian safety."
        }
      ],
      [
        "expo-brightness",
        {
          "brightnessPermission": "Allow SmombieAlert to dim your screen as a safety warning when distracted phone use is detected."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "d8e21629-6eaa-4975-b479-b60996da39e3"
      }
    },
    "owner": "summerhill",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d8e21629-6eaa-4975-b479-b60996da39e3"
    }
  }
}
